# ============================================================================
# Personal AI Assistant - environment template
# Copy to `.env` and fill in real values. NEVER commit `.env` (it is git-ignored).
# ============================================================================

# ----- PostgreSQL (required) -----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=ai_assistant

# ----- Backend -----
# Async SQLAlchemy URL used by the FastAPI backend.
DATABASE_URL=postgresql+asyncpg://postgres:change-me-in-production@postgres:5432/ai_assistant

# ----- LLM provider -----
# Real key must come from the environment; never hard-code or commit it.
# NOTE: config reads OPENAI_* (see backend/app/config.py), not LLM_*.
OPENAI_API_KEY=your-llm-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: Volcano Ark embeddings (leave blank to use deterministic fallback)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# ----- Security -----
# Secret used to sign admin JWTs for the observability Admin API. MUST be set
# in production and must be a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# ----- Application -----
# development | production
APP_ENV=development
LOG_LEVEL=INFO

# ----- Frontend -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
