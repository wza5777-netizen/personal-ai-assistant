# Base URL of the backend API. Built into the client at build time
# (NEXT_PUBLIC_* vars are inlined by Next.js), so set this in the
# Render dashboard before building. No trailing slash.
# Production example:
# NEXT_PUBLIC_API_BASE_URL=https://personal-ai-assistant-l97e.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
