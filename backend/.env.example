# Template for environment variables. Copy to .env (production) or use .env.dev (local).
# NOTE: .env and .env.dev are gitignored and must NEVER be committed with real secrets.

# ---- Database ----
# Local development (default if APP_ENV=development):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_assistant
#
# Production (Render injects this via dashboard -> Neon asyncpg URL):
# DATABASE_URL=postgresql+asyncpg://neondb_owner:***@ep-xxx.aws.neon.tech/neondb?ssl=require

# ---- LLM (Volcano Ark) ----
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=doubao-seed-2.1-turbo
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
EMBEDDING_MODEL=doubao-embedding-vision

# ---- App ----
# development -> loads .env.dev automatically; production -> loads .env
APP_ENV=development
LOG_LEVEL=INFO

# JWT secret for admin auth (production must set a strong value)
JWT_SECRET=

# Comma-separated allowed browser origins for production CORS
CORS_ORIGINS=

# ---- Model-aware cost tracking ----
# JSON map of model name -> per-1M-token prices (USD). Used to compute
# run.estimated_cost_usd in observability. If a model is not listed here, its
# cost is reported as null (unavailable) rather than being guessed.
# Example (single line):
# MODEL_PRICING={"gpt-4o-mini":{"input_per_1m":0.15,"output_per_1m":0.60},"deepseek-chat":{"input_per_1m":0.27,"output_per_1m":1.10}}
MODEL_PRICING=

# ---- GitHub official Remote MCP Server (read-only, opt-in) ----
# Set to true to enable. When enabled, the app connects to GitHub's managed
# remote MCP endpoint and exposes repos/issues/pull_requests read tools under
# the "github." namespace (e.g. github.get_issue), gated by "github:read".
GITHUB_MCP_ENABLED=true
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_MCP_TOKEN=
# Comma-separated read-only toolset allow-list; keep minimal.
GITHUB_MCP_TOOLSETS=repos,issues,pull_requests
GITHUB_MCP_TIMEOUT=30.0
# Default GitHub owner used when the user says "my <repo>" without naming one.
# Overrides the built-in default. No secret.
GITHUB_DEFAULT_OWNER=wza5777-netizen
